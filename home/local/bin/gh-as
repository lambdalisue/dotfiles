#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
host=${GH_HOST:-github.com}
remote=${GH_AS_REMOTE:-origin}

die() {
  printf '%s: %s\n' "$program" "$1" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Run a command authenticated as one of the gh accounts logged in on this machine.

Usage:
  gh-as <command> [args...]               account resolved from the repository
  gh-as <account> -- <command> [args...]  account named explicitly
  gh-as --list

Options:
  -l, --list       List the accounts logged in on the host
      --host HOST  Host to take the account from (default: $GH_HOST or github.com)
  -h, --help       Show this help

Examples:
  gh-as gh pr list
  gh-as lambdalisue-attmcojp -- gh pr create
  gh-as lambdalisue -- ./scripts/release.ts

Environment:
  GH_AS_REMOTE  Remote to resolve the account from (default: origin)
USAGE
}

# `gh auth status` is the only interface that enumerates accounts; hosts.yml
# holds no tokens under a keyring setup and needs a YAML parser besides.
accounts() {
  env -u GH_TOKEN -u GITHUB_TOKEN gh auth status --hostname "$host" 2>&1 |
    grep -oE 'account [^ ]+' | cut -d' ' -f2 | sort -u
}

normalize_url() {
  local url=$1 authority path
  url=${url%/}
  url=${url%.git}
  case $url in
    *://*) url=${url#*://} ;;
    *:*) url=${url/:/\/} ;;
  esac
  authority=${url%%/*}
  path=${url#*/}
  authority=${authority##*@}
  authority=${authority%%:*}
  printf 'https://%s/%s\n' "$authority" "$path"
}

# The account per repository is already declared in gitconfig: every
# `[credential "<url>"]` section names the account its helper hands the token
# of. Reading it back with --get-urlmatch keeps that one declaration the single
# source of truth instead of restating the org-to-account mapping here.
detect_account() {
  local url account
  url=$(git remote get-url "$remote" 2>/dev/null) ||
    die "no '$remote' remote here; name the account explicitly (see --help)"
  url=$(normalize_url "$url")
  account=$(git config --get-urlmatch credential.username "$url" 2>/dev/null) || account=
  [[ -n $account ]] ||
    die "no credential.username configured for $url; name the account explicitly (see --help)"
  printf '%s\n' "$account"
}

has_separator() {
  local arg
  for arg in "$@"; do
    if [[ $arg == -- ]]; then
      return 0
    fi
  done
  return 1
}

account=
while [[ $# -gt 0 ]]; do
  case $1 in
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -l | --list)
      accounts
      exit 0
      ;;
    --host)
      [[ $# -ge 2 ]] || die "--host needs a value"
      host=$2
      shift 2
      ;;
    --host=*)
      host=${1#*=}
      shift
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      has_separator "$@" || break
      [[ -z $account ]] || die "more than one account given"
      account=$1
      shift
      ;;
  esac
done

[[ $# -gt 0 ]] || die "no command given (see --help)"

# `gh auth login|switch|logout` bail out with "The value of the GH_TOKEN
# environment variable is being used for authentication", so wrapping them
# would only produce a confusing failure.
if [[ ${1##*/} == gh ]]; then
  for arg in "${@:2}"; do
    case $arg in
      -*) continue ;;
      auth) die "gh auth refuses to run under an injected token; run it without $program" ;;
      *) break ;;
    esac
  done
fi

if [[ -z $account ]]; then
  account=$(detect_account) || exit 1
fi

# An inherited GH_TOKEN wins over --user and would hand back the ambient token
# under a different name.
token=$(env -u GH_TOKEN -u GITHUB_TOKEN gh auth token --hostname "$host" --user "$account" 2>/dev/null) ||
  die "no token for account '$account' on $host; logged in are: $(accounts | tr '\n' ' ')"

printf '%s: running as %s\n' "$program" "$account" >&2

# Injecting the token beats `gh auth switch`: switching rewrites
# ~/.config/gh/hosts.yml, which every other shell and agent on this machine
# shares, so concurrent runs race and an interrupted run leaves the wrong
# account active. The environment dies with this process instead.
exec env -u GITHUB_TOKEN GH_TOKEN="$token" GH_AS_ACCOUNT="$account" "$@"
