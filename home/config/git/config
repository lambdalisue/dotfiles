[user]
  name  = Alisue
  email = lambdalisue@gmail.com
  signingkey = B11731DAB90A2400

[rerere]
  enabled = true

[core]
  autocrlf = input
  ignorecase = false
  quotepath = false

[color]
  ui = auto

[push]
  default = current
  useForceIfIncludes = true

[branch]
  autosetupmerge = always

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

[commit]
  gpgsign = true
  verbose = true

[diff]
  algorithm = patience
  colormoved = dimmed-zebra

[alias]
  push-f = push --force-with-lease --force-if-includes
  browse = "!deno run --allow-net --allow-run --allow-read --allow-env jsr:@lambdalisue/git-browse/cli"

[init]
  defaultBranch = main

[github]
  user = lambdalisue

[ghq]
  root = ~/ghq

[fetch]
  prune = true

[include]
  path = ~/.gitconfig.local

; The empty helper line is load-bearing: the system gitconfig that ships with
; the Nix git package sets credential.helper=osxkeychain for every URL, and
; helpers run in configuration order, so the keychain would answer with a stale
; token before gh is ever asked. Resetting the list here scopes that reset to
; GitHub and leaves osxkeychain in place for every other host.
;
; `gh auth git-credential` is deliberately not used: it only ever answers for
; the account that happens to be active, and two accounts are logged in here.
; Asking for the token by name keeps the identity pinned to the URL instead.
[credential "https://github.com"]
  helper =
  helper = "!f() { test \"$1\" = get || exit 0; echo username=lambdalisue; echo password=\"$(gh auth token -h github.com -u lambdalisue)\"; }; f"

[credential "https://gist.github.com"]
  helper =
  helper = "!f() { test \"$1\" = get || exit 0; echo username=lambdalisue; echo password=\"$(gh auth token -h github.com -u lambdalisue)\"; }; f"

[wt]
  nocopy = dist/
  nocopy = target/
  nocopy = node_modules/
  copy = .envrc
  copy = .env
