[user]
  name  = Alisue
  email = lambdalisue@gmail.com
  signingkey = B11731DAB90A2400

[rerere]
  enabled = true

[core]
  autocrlf = input
  ignorecase = false
  quotepath = false

[color]
  ui = auto

[push]
  default = current
  useForceIfIncludes = true

[branch]
  autosetupmerge = always

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

[commit]
  gpgsign = true
  verbose = true

[diff]
  algorithm = patience
  colormoved = dimmed-zebra

[alias]
  push-f = push --force-with-lease --force-if-includes
  browse = "!deno run --allow-net --allow-run --allow-read --allow-env jsr:@lambdalisue/git-browse/cli"

[init]
  defaultBranch = main

[github]
  user = lambdalisue

[ghq]
  root = ~/ghq

[fetch]
  prune = true

[include]
  path = ~/.gitconfig.local

; The empty helper line is load-bearing: the system gitconfig that ships with
; the Nix git package sets credential.helper=osxkeychain for every URL, and
; helpers run in configuration order, so the keychain would answer with a stale
; token before gh is ever asked. Resetting the list here scopes that reset to
; GitHub and leaves osxkeychain in place for every other host.
;
; `gh auth git-credential` is deliberately not used: it only ever answers for
; the account that happens to be active, and two accounts are logged in here.
; Asking for the token by name keeps the identity pinned to the URL instead.
;
; useHttpPath is what keeps the per-organization address below reachable from
; git-lfs. Unless it is set, git-lfs asks the credential machinery for
; protocol+host only, so a section scoped to a path can never match and the
; personal token answers for a work repository -- the LFS batch API then 404s
; ("batch response: Not Found") and checkout dies in the smudge filter. Plain
; git is unaffected either way, because it always knows the full URL. The
; helpers here ignore the extra path field, so turning it on costs nothing.
[credential "https://github.com"]
  useHttpPath = true
  helper =
  helper = "!f() { test \"$1\" = get || exit 0; echo username=lambdalisue; echo password=\"$(gh auth token -h github.com -u lambdalisue)\"; }; f"

[credential "https://gist.github.com"]
  helper =
  helper = "!f() { test \"$1\" = get || exit 0; echo username=lambdalisue; echo password=\"$(gh auth token -h github.com -u lambdalisue)\"; }; f"

; Work repositories authenticate as the work account. This one is unconditional
; on purpose: the URL already scopes it, so it cannot reach a personal
; repository, and loading it always means it applies to bare `ls-remote`-style
; commands run from outside a work checkout too.
[credential "https://github.com/attmcojp"]
  helper =
  helper = "!f() { test \"$1\" = get || exit 0; echo username=lambdalisue-attmcojp; echo password=\"$(gh auth token -h github.com -u lambdalisue-attmcojp)\"; }; f"

; The work identity, on the other hand, has to stay conditional — included
; unconditionally it would override the address above for every repository.
; Matched two ways so it survives clones outside the ghq tree: gitdir catches
; the repository before `git clone` has written a remote, hasconfig catches
; everything already cloned.
[includeIf "gitdir:~/ghq/github.com/attmcojp/"]
  path = config.attmcojp

[includeIf "hasconfig:remote.*.url:https://github.com/attmcojp/**"]
  path = config.attmcojp

[includeIf "hasconfig:remote.*.url:git@github.com:attmcojp/**"]
  path = config.attmcojp

[includeIf "hasconfig:remote.*.url:ssh://git@github.com/attmcojp/**"]
  path = config.attmcojp

[wt]
  # Keep worktrees under .claude/worktrees so Claude Code's EnterWorktree
  # accepts them without the hard-coded relocation prompt (paths outside
  # .claude/worktrees/ always ask, regardless of permission rules).
  basedir = .claude/worktrees
  nocopy = dist/
  nocopy = target/
  nocopy = node_modules/
  copy = .envrc
  copy = .env
