{
  "directory": {
    "defaultDirectory": "/Users/alisue/Compost/AI-Notes",
    "onStartup": "default"
  },
  "fileOpen": "last_focused",
  "markdown": {
    "autoLinkUrls": true,
    "math": true,
    "wikiLinks": true,
    "superscript": true,
    "subscript": true,
    "definitionLists": true,
    "headingAttributes": true,
    "smartPunctuation": true,
    "cjkEmphasis": true,
    "headingPermalinks": false,
    "rawHtml": "filter"
  },
  "theme": {
    "defaultTheme": "auto",
    "lightTheme": "light",
    "darkTheme": "dark_dimmed",
    "onStartup": "default",
    "onNewWindow": "default"
  },
  "sidebar": {
    "defaultPinned": false,
    "defaultWidth": 280.0,
    "defaultShowAllFiles": false,
    "defaultZoomLevel": 1.0,
    "minContentWidth": 640.0,
    "recentTrace": "hidden_when_sidebar",
    "recentTraceCount": 6,
    "onOpen": "keep_open",
    "onStartup": "default",
    "onNewWindow": "default"
  },
  "windowPosition": {
    "defaultPosition": {
      "x": {
        "value": 50.0,
        "unit": "percent"
      },
      "y": {
        "value": 50.0,
        "unit": "percent"
      }
    },
    "defaultPositionMode": "coordinates",
    "positionOffset": {
      "x": 20,
      "y": 20
    },
    "onStartup": "default",
    "onNewWindow": "default"
  },
  "windowSize": {
    "defaultSize": {
      "width": {
        "value": 1000.0,
        "unit": "pixels"
      },
      "height": {
        "value": 800.0,
        "unit": "pixels"
      }
    },
    "onStartup": "default",
    "onNewWindow": "default"
  },
  "zoom": {
    "defaultZoomLevel": 1.0,
    "onStartup": "default",
    "onNewWindow": "default"
  }
}