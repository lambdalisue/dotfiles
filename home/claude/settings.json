{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git backup:*)",
      "Bash(git branch backup/:*)",
      "EnterWorktree"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/warn-mod-rs.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-perl.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-subagent-model.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun x ccusage statusline",
    "padding": 0
  },
  "enabledPlugins": {
    "gh-as@gh-as": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "probitas@probitas-test": true,
    "swift-lsp@claude-plugins-official": true,
    "cclens@cclens": true,
    "kuchiyose@kuchiyose": true,
    "figures@figures": true
  },
  "extraKnownMarketplaces": {
    "gh-as": {
      "source": {
        "source": "github",
        "repo": "lambdalisue/gh-as"
      },
      "autoUpdate": true
    },
    "probitas-test": {
      "source": {
        "source": "github",
        "repo": "probitas-test/claude-plugins"
      }
    },
    "cclens": {
      "source": {
        "source": "github",
        "repo": "lambdalisue/cclens"
      },
      "autoUpdate": true
    },
    "kuchiyose": {
      "source": {
        "source": "github",
        "repo": "lambdalisue/kuchiyose"
      }
    },
    "figures": {
      "source": {
        "source": "github",
        "repo": "natsukium/claude-code-figures-plugin"
      }
    }
  },
  "effortLevel": "high",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
